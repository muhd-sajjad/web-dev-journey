# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection string (Neon / Supabase / Render Postgres / local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend URLs allowed to call this API (production).
# Leave empty locally to allow http://localhost:5173.
CORS_ORIGINS=
# Optional regex, e.g. to allow Vercel previews: https://trackly-.*\.vercel\.app
CORS_ORIGIN_REGEX=
